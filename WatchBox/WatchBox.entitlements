<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst runs sandboxed. Outgoing: addons, peers, trackers, debrid.
	     Incoming: the localhost stream server VLC reads from, and peer connections. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Importing a GoogleService-Info.plist through the file picker. A sandboxed
	     app cannot read a user-chosen file without this: the open panel still
	     appears, but the returned URL is unreadable, so the import silently did
	     nothing no matter how many times the file was tapped. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Firebase Auth persists the signed-in user in the Keychain; on macOS it
	     needs an explicit access group or every sign-in fails (errSecMissingEntitlement). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
</dict>
</plist>
